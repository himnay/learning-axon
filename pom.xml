<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.org.llm</groupId>
        <artifactId>super-pom</artifactId>
        <version>1.1.3</version>
        <relativePath>../super-pom/pom.xml</relativePath>
    </parent>

    <groupId>com.learning.axon</groupId>
    <artifactId>learning-axon</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>learning-axon</name>
    <description>
        Axon Framework CQRS + Event Sourcing + Saga learning project.
        Multi-module Maven project demonstrating Command, Observer, Template Method,
        Builder, Factory, Strategy, Singleton and Chain-of-Responsibility GoF patterns.
    </description>

    <modules>
        <module>axon-shared</module>
        <module>axon-command-service</module>
        <module>axon-query-service</module>
        <module>axon-saga-service</module>
        <module>axon-debit-card-service</module>
        <module>axon-cheque-book-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <axon.version>4.13.3</axon.version>
        <axon.amqp.version>4.12.0</axon.amqp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- axon-bom manages every core 4.x module (messaging, modelling, eventsourcing,
                 spring-boot-starter, test, ...) in lock-step. Extensions version separately. -->
            <dependency>
                <groupId>org.axonframework</groupId>
                <artifactId>axon-bom</artifactId>
                <version>${axon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.axonframework.extensions.amqp</groupId>
                <artifactId>axon-amqp-spring-boot-starter</artifactId>
                <version>${axon.amqp.version}</version>
            </dependency>

            <dependency>
                <groupId>com.learning.axon</groupId>
                <artifactId>axon-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
